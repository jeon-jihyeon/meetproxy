#!/bin/sh
# Runs the meetproxy binary matching the plugin version, found in this order
# 1. a dev build when the plugin is loaded from its source tree
# 2. ~/.meetproxy/bin/v<version>/meetproxy
# 3. the GitHub release through the user's gh login, verified against checksums.txt
# 4. another meetproxy on PATH
set -eu

MODE=cli

REPO="jeon-jihyeon/meetproxy"
# Hooks start the launcher by its absolute path so only other starts resolve the directory with programs
dir=${0%/*}
case "$dir" in
  /*/bin) ROOT=${dir%/bin} ;;
  *) ROOT=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd) ;;
esac
MANIFEST="${ROOT}/.claude-plugin/plugin.json"
SRC=${ROOT%/*}
[ -n "$SRC" ] || SRC=/

fail() {
  echo "meetproxy: $1" >&2
  exit 1
}

# Rebuilds when sources are newer and renames into place so a partial file never runs
dev=
if [ -f "${SRC}/go.mod" ] && command -v go >/dev/null 2>&1; then
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "module github.com/${REPO}") dev=yes && break ;;
      "module "*) break ;;
    esac
  done <"${SRC}/go.mod"
fi
if [ -n "$dev" ]; then
  DEV_BIN="${SRC}/bin/meetproxy"
  if [ ! -x "$DEV_BIN" ] || { [ "$MODE" = cli ] && [ -n "$(find "${SRC}/app" "${SRC}/cmd" "${SRC}/internal" "${SRC}/go.mod" -newer "$DEV_BIN" 2>/dev/null | head -n 1)" ]; }; then
    mkdir -p "${SRC}/bin"
    tmp="${DEV_BIN}.$$"
    if (cd "$SRC" && go build -o "$tmp" ./cmd/meetproxy) >&2; then
      mv -f "$tmp" "$DEV_BIN"
    else
      rm -f "$tmp"
      fail "could not build ${SRC}"
    fi
  fi
  exec "$DEV_BIN" "$@"
fi

# The first "version" key of the manifest such as   "version": "0.1.9",
version=
while IFS= read -r line || [ -n "$line" ]; do
  key=${line#"${line%%[![:space:]]*}"}
  case "$key" in
    \"version\"*)
      value=${key#\"version\"}
      gap=${value%%\"*}
      case "$gap" in
        *[!:\ \	]* | *:*:*) continue ;;
        *:*) ;;
        *) continue ;;
      esac
      value=${value#*\"}
      case "$value" in
        *\"*) version=${value%%\"*} && break ;;
      esac
      ;;
  esac
done <"$MANIFEST" || true
[ -n "$version" ] || fail "no version in ${MANIFEST}"
TAG="v${version}"

BIN_DIR="${HOME}/.meetproxy/bin/${TAG}"
BIN="${BIN_DIR}/meetproxy"
if [ -x "$BIN" ]; then
  exec "$BIN" "$@"
fi

os=$(uname -s | tr '[:upper:]' '[:lower:]')
arch=$(uname -m)
case "$arch" in
  x86_64) arch=amd64 ;;
  aarch64 | arm64) arch=arm64 ;;
esac
ARCHIVE="meetproxy_${os}_${arch}.tar.gz"
BASE_URL="https://github.com/${REPO}/releases/download/${TAG}"
LOGIN="run gh auth login, then run again"

sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | cut -d ' ' -f 1
    return
  fi
  if command -v shasum >/dev/null 2>&1; then
    shasum -a 256 "$1" | cut -d ' ' -f 1
    return
  fi
  return 1
}

# Returns 1 to try the next source and exits on a checksum mismatch
# The download itself tells whether the active login reads the release
# gh auth status fails on any broken account of the host and offline, so it is no signal
# Only a missing gh or token gets the fixed login line
fetch() {
  if ! command -v gh >/dev/null 2>&1; then
    echo "meetproxy: ${LOGIN}" >&2
    return 1
  fi
  mkdir -p "$BIN_DIR" || return 1
  tmp=$(mktemp -d "${BIN_DIR}/.fetch.XXXXXX") || return 1
  # The host in --repo keeps a GH_HOST of the user's shell from picking another host's release
  if ! gh release download "$TAG" --repo "github.com/${REPO}" --pattern "$ARCHIVE" --pattern checksums.txt --dir "$tmp" >/dev/null 2>&1; then
    rm -rf "$tmp"
    gh auth token --hostname github.com >/dev/null 2>&1 || echo "meetproxy: ${LOGIN}" >&2
    return 1
  fi
  if ! got=$(sha256 "${tmp}/${ARCHIVE}") || [ -z "$got" ]; then
    rm -rf "$tmp"
    echo "meetproxy: cannot compute the sha256 of ${ARCHIVE}, so it is not trusted" >&2
    return 1
  fi
  want=$(awk -v f="$ARCHIVE" '$2 == f { print $1 }' "${tmp}/checksums.txt")
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    rm -rf "$tmp"
    fail "checksum of ${BASE_URL}/${ARCHIVE} does not match checksums.txt, refusing to run it"
  fi
  if ! tar -xzf "${tmp}/${ARCHIVE}" -C "$tmp" meetproxy || ! chmod +x "${tmp}/meetproxy" || ! mv -f "${tmp}/meetproxy" "$BIN"; then
    rm -rf "$tmp"
    return 1
  fi
  rm -rf "$tmp"
  echo "meetproxy: fetched ${BASE_URL}/${ARCHIVE} into ${BIN}" >&2
}

if fetch; then
  exec "$BIN" "$@"
fi

# Skips this launcher itself when the plugin bin directory is on PATH
found=$(command -v meetproxy 2>/dev/null || true)
if [ -n "$found" ] && [ ! "$found" -ef "$0" ]; then
  have=$("$found" version 2>/dev/null </dev/null || echo unknown)
  case "$have" in
    "$version" | "v$version") ;;
    *) echo "meetproxy: running ${found} from PATH, version ${have} where the plugin expects ${version}" >&2 ;;
  esac
  exec "$found" "$@"
fi

fail "could not fetch ${TAG} from ${BASE_URL} through gh. Check that gh auth login can read ${REPO}, then run again"
